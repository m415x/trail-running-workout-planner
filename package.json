{
  "name": "trail-running-workout-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/test-runner.ts",
    "tsc": "tsx scripts/typecheck-runner.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:sqlite:push": "drizzle-kit push",
    "db:sqlite:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:sqlite:upgrade": "tsx scripts/upgrade-sqlite.ts",
    "db:sqlite:verify": "tsx scripts/verify-sqlite.ts",
    "db:sqlite:check": "pn exec tsx scripts/verify-sqlite-scenarios.ts empty && pn exec tsx scripts/verify-sqlite-scenarios.ts full-seed && pn exec tsx scripts/verify-sqlite-scenarios.ts partial-seed && pn exec tsx scripts/verify-sqlite-scenarios.ts upgrade && pn exec tsx scripts/verify-sqlite-scenarios.ts preservation && pn exec tsx scripts/verify-sqlite-scenarios.ts drift && pn exec tsx scripts/verify-sqlite-scenarios.ts rerun && pn exec tsx scripts/verify-sqlite-scenarios.ts partial-metadata-head",
    "db:supabase:generate": "drizzle-kit generate --config=drizzle.supabase.config.ts",
    "db:supabase:check": "drizzle-kit check --config=drizzle.supabase.config.ts",
    "db:supabase:migrate": "drizzle-kit migrate --config=drizzle.supabase.config.ts",
    "db:supabase:verify": "tsx db/supabase/verify.ts",
    "db:supabase:verify:h11": "tsx db/supabase/verify-planning-review-transaction.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:base": "tsx db/seed.ts",
    "db:seed:race-catalog": "tsx db/seeds/race-catalog-fixtures.ts",
    "db:seed:realized-training": "tsx db/seeds/realized-training-fixtures.ts",
    "db:seed:plan-real": "tsx db/seeds/plan-real-comparison-fixtures.ts",
    "db:seed": "pn db:seed:base && pn db:seed:race-catalog && pn db:seed:realized-training && pn db:seed:plan-real",
    "tdd:red": "tsx scripts/tdd.ts --red",
    "tdd": "tsx scripts/tdd.ts"
  },
