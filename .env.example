# Runtime en Vercel: URI del Shared Pooler en transaction mode (puerto 6543).
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Migraciones: URI directa (puerto 5432). No debe exponerse al navegador.
SUPABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase Auth (public project configuration; safe for browser/server clients).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
